{
  "name": "taj-band",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "node scripts/build.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "build:api": "pnpm --filter @taj/types build && pnpm --filter api generate && pnpm --filter api build && pnpm --filter api exec prisma migrate deploy",
    "build:web": "pnpm --filter @taj/types build && pnpm --filter web exec next build --webpack && node scripts/web-standalone-assets.mjs",
    "start:api": "node apps/api/dist/main.js",
    "start:web": "node apps/web/.next/standalone/apps/web/server.js"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.7"
  }
}
