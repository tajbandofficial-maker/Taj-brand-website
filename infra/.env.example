# Production settings for infra/docker-compose.prod.yml.
# Don't edit by hand on a fresh server — run `bash infra/setup.sh`, which creates infra/.env
# with strong random secrets. Never commit infra/.env.

# Your domain, without https:// or www (DNS A records for DOMAIN, www.DOMAIN, s3.DOMAIN → server IP)
DOMAIN=
# Let's Encrypt contact (certificate expiry notices)
ACME_EMAIL=

# Secrets (random; changing POSTGRES_PASSWORD later locks you out of existing data)
POSTGRES_PASSWORD=
JWT_SECRET=
INTERNAL_API_TOKEN=
REVALIDATE_SECRET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# First admin login (created on first deploy; password 12+ characters)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email — our inbox (shown in emails, gets client replies and new-enquiry alerts)
BUSINESS_EMAIL=
# Optional: send alerts elsewhere / to several people (comma-separated)
INQUIRY_NOTIFY_EMAILS=
# Sending via Gmail: the Gmail address + a Gmail App Password (myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
# …or via Resend instead: API key + sender on your verified domain
RESEND_API_KEY=
MAIL_FROM=

# Optional: Cloudflare Turnstile spam check and Cloudflare cache purge
TURNSTILE_SECRET_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
