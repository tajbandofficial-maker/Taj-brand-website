# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
# Must match the API's INTERNAL_API_TOKEN / REVALIDATE_SECRET
INTERNAL_API_TOKEN=replace-with-32-plus-random-characters
REVALIDATE_SECRET=replace-with-32-plus-random-characters
SESSION_COOKIE_NAME=tb_session

# Optional in development
# Production: media.tajband.in · Local RustFS: http://localhost:9000
NEXT_PUBLIC_MEDIA_HOST=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
