# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://taj:taj@localhost:5432/tajband
JWT_SECRET=replace-with-64-random-characters
INTERNAL_API_TOKEN=replace-with-32-plus-random-characters
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=replace-with-32-plus-random-characters
PUBLIC_SITE_URL=http://localhost:3000

# Required in production, optional in development.
# Local storage (RustFS via pnpm db:up): R2_ACCOUNT_ID=local R2_ACCESS_KEY_ID=taj-dev
# R2_SECRET_ACCESS_KEY=taj-dev-secret R2_BUCKET=taj-media
# R2_PUBLIC_BASE_URL=http://localhost:9000/taj-media R2_ENDPOINT=http://localhost:9000
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
TURNSTILE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Dev: point at the RustFS container from `pnpm db:up` instead of R2
R2_ENDPOINT=
# Email — Gmail: SMTP_USER = your Gmail address, SMTP_PASS = a Gmail App Password
# (Google Account → Security → 2-Step Verification → App passwords). Not your normal password.
SMTP_USER=
SMTP_PASS=
# Or Resend instead of Gmail (needs MAIL_FROM on a verified domain):
RESEND_API_KEY=
MAIL_FROM=
# Our inbox: shown in emails, gets client replies and (if INQUIRY_NOTIFY_EMAILS is empty) new-enquiry alerts
BUSINESS_EMAIL=
INQUIRY_NOTIFY_EMAILS=

# Seed only — first admin login (password: 12+ characters)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SWAGGER_ENABLED=false
