// Prisma 7: the connection URL lives in prisma.config.ts (datasource.url),
// and PrismaClient connects through the @prisma/adapter-mariadb driver adapter
// (works with MySQL 8 and MariaDB 10.6+, e.g. Hostinger's MySQL databases).
//
// MySQL notes:
// - A plain `String` is VARCHAR(191). Free text uses @db.Text (64 KB) so nothing is truncated.
// - MySQL has no array columns: lists of strings are stored as Json (a JSON array of strings).
// - MySQL can't default a JSON column, so Json fields get their defaults in code
//   (src/prisma/json-defaults.ts).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(255)
  passwordHash String
  name         String    @db.VarChar(255)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(512) // R2 object key (content-hashed)
  url       String   @db.Text // public URL on media.<domain>
  mimeType  String
  width     Int?
  height    Int?
  alt       String   @db.Text // required
  createdAt DateTime @default(now())

  serviceHeroes   Service[]      @relation("ServiceHero")
  galleryItems    GalleryItem[]
  reviewImages    Review[]       @relation("ReviewImage")
  pageHeroes      PageContent[]  @relation("PageHero")
  pageOgImages    PageContent[]  @relation("PageOgImage")
  serviceOgImages Service[]      @relation("ServiceOgImage")
  siteOgImages    SiteSettings[] @relation("SiteOgImage")
}

model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String        @db.Text // nav/card title, e.g. "Brass Band & Baraat"
  h1               String        @db.Text // SEO H1
  shortDescription String        @db.Text // card text
  intro            String        @db.Text // opening paragraph
  sections         Json // [{ heading: string, body: string }]
  inclusions       Json // string[]
  areaCopy         String?       @db.Text // area-served paragraph
  heroImageId      String?
  heroImage        Media?        @relation("ServiceHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  seoTitle         String?       @db.Text
  seoDescription   String?       @db.Text
  ogImageId        String? // social share image; falls back to the hero photo
  ogImage          Media?        @relation("ServiceOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  order            Int           @default(0)
  published        Boolean       @default(false)
  faqs             Faq[]
  relatedPackages  Package[]     @relation("ServicePackages")
  galleryItems     GalleryItem[] // photos shown on this service's page
  addOns           AddOn[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Package {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String    @db.Text // Classic / Royal / Maharaja
  tagline       String?   @db.Text
  startingPrice Int? // INR; null → "Price on request"
  priceNote     String?   @db.Text // e.g. "per baraat, Delhi-NCR"
  inclusions    Json // string[]
  highlighted   Boolean   @default(false)
  order         Int       @default(0)
  published     Boolean   @default(false)
  services      Service[] @relation("ServicePackages")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AddOn {
  id            String   @id @default(cuid())
  name          String   @db.Text
  description   String?  @db.Text
  startingPrice Int?
  serviceId     String? // optional service page the add-on links to
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  order         Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// One row of the /packages comparison table; `values` follow published package order.
model PackageComparisonRow {
  id        String   @id @default(cuid())
  label     String   @db.Text
  values    Json // string[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GalleryType {
  IMAGE
  VIDEO
}

enum GalleryCategory {
  BARAAT
  BAND
  DHOL
  SHEHNAI
  CARS_CHATTAR
  LIGHTING
  VIDEO
}

model GalleryItem {
  id        String          @id @default(cuid())
  type      GalleryType
  category  GalleryCategory
  mediaId   String? // required when IMAGE; poster when VIDEO
  media     Media?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  youtubeId String? // required when VIDEO
  caption   String?         @db.Text // video title / photo caption
  serviceId String? // also show on this service's page
  service   Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  order     Int             @default(0)
  published Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

enum ReviewSource {
  GOOGLE
  DIRECT
  HIGH_PROFILE
}

model Review {
  id        String       @id @default(cuid())
  author    String       @db.Text
  rating    Int // 1–5 (validate)
  text      String       @db.Text
  meta      String?      @db.Text // e.g. "Royal package · Gurugram"
  source    ReviewSource
  imageId   String? // photo for high-profile weddings
  image     Media?       @relation("ReviewImage", fields: [imageId], references: [id], onDelete: SetNull)
  eventDate DateTime?
  featured  Boolean      @default(false)
  order     Int          @default(0)
  published Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  serviceId String? // null = global FAQ
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum InquiryStatus {
  NEW
  CONTACTED
  BOOKED
  LOST
  SPAM
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(255)
  phone       String
  email       String?       @db.VarChar(255) // optional: gets the confirmation email
  weddingDate DateTime?
  venue       String?       @db.VarChar(255)
  services    Json // string[] of service slugs
  message     String?       @db.Text
  sourcePage  String?       @db.Text
  ip          String?
  status      InquiryStatus @default(NEW)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

model SiteSettings {
  id                     Int      @id @default(1) // singleton
  businessName           String   @default("Taj Band") @db.VarChar(255)
  tagline                String   @default("Old Is Gold") @db.VarChar(255)
  phone                  String
  whatsapp               String // E.164 without "+", e.g. 91XXXXXXXXXX
  altPhone               String? // second number, shown beside the main phone
  email                  String?  @db.VarChar(255)
  addressLine            String   @db.Text
  city                   String   @db.VarChar(255)
  postalCode             String?
  geoLat                 Float?
  geoLng                 Float?
  hours                  Json // [{ days: string[], opens: "09:00", closes: "21:00" }]
  mapEmbedUrl            String?  @db.Text
  googleRating           Float?
  googleReviewCount      Int?
  googleProfileUrl       String?  @db.Text
  foundedYear            Int?
  weddingsPerformed      Int?
  netflixUrl             String?  @db.Text
  socials                Json // { instagram, facebook, youtube }
  serviceAreas           Json // string[]
  whatsappDefaultMessage String   @default("Hi Taj Band, I'd like to check availability for my wedding.") @db.VarChar(1000)
  ticker                 Json // string[]
  netflixBlurb           String?  @db.Text // short line under "As seen on Netflix"
  // Site-wide SEO: title of the home page and suffix of every other title, plus fallbacks.
  seoSiteTitle           String   @default("Taj Band — Wedding Band & Baraat, Delhi") @db.VarChar(500)
  seoDescription         String?  @db.Text
  ogImageId              String? // default social share image
  ogImage                Media?   @relation("SiteOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  updatedAt              DateTime @updatedAt
}

/// Copy, hero image, featured video and SEO of one fixed page (keys: pageDefs in @taj/types).
/// `fields` holds only what the admin saved; the site falls back to each field's default.
model PageContent {
  key            String   @id // "home", "about", …
  fields         Json // { [fieldKey]: string }
  heroImageId    String?
  heroImage      Media?   @relation("PageHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  youtubeId      String?
  seoTitle       String?  @db.Text
  seoDescription String?  @db.Text
  ogImageId      String? // social share image
  ogImage        Media?   @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt
}
